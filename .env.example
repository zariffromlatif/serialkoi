# Copy to .env. "sim" runs everything locally; "live" calls api.applink.com.bd
SK_MODE=sim

# From the Applink developer portal (the API key arrives by email after approval)
APPLINK_APP_ID=APP_000000
APPLINK_PASSWORD=

# The app's USSD code: Applink service code + your keyword, e.g. *383*44# (placeholder until provisioning).
# Patients dial the code plus a chamber code: *383*44*4521#
SK_USSD_CODE=*213#
# First word of inbound SMS, e.g. "SK STATUS"
SK_SMS_KEYWORD=SK
# The number patients text (Applink's shared short code, e.g. 77000), shown on posters
SK_SMS_SHORTCODE=

# Change both before going live
SK_SECRET=change-me-to-a-long-random-string
SK_ADMIN_KEY=

# 1 = create the demo chamber (code 4521, PIN 2468) on start
SK_SEED_DEMO=1
